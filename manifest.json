{
  "manifest_version": 3,
  "name": "归藏 — 收藏夹管理",
  "short_name": "归藏",
  "version": "0.11.0",
  "description": "看得清、归得位、救得回：地址栏秒搜、AI 归类逐条确认、去重体检与时光机抢救。",
  "minimum_chrome_version": "116",
  "permissions": ["bookmarks", "storage", "tabs", "sidePanel", "favicon", "contextMenus"],
  "optional_permissions": ["history", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "omnibox": {
    "keyword": "gz"
  },
  "commands": {
    "open-manager": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "打开归藏全屏书库"
    },
    "stash-current": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "将当前标签页快速收进待归类"
    },
    "stash-window": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "将当前窗口全部标签页收进待归类"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "归藏",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "ui/sidepanel.html" },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
